{
  "name": "plume",
  "productName": "Plume",
  "version": "1.5.1",
  "description": "Plume — a feather-light Markdown viewer",
  "author": "Ishan Nim",
  "license": "MIT",
  "homepage": "https://github.com/Ishan-Nim/plume",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "icons": "electron scripts/make-icons.js",
    "start": "node scripts/build.js && electron .",
    "test": "node --test test/*.test.js",
    "dist": "node scripts/build.js --release && electron-builder --win nsis --x64",
    "dist:mac": "node scripts/build.js --release && electron-builder --mac",
    "dist:linux": "node scripts/build.js --release && electron-builder --linux"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "dompurify": "^3.4.16",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.1.0"
  },
  "build": {
    "appId": "app.plume.viewer",
    "productName": "Plume",
    "copyright": "Copyright © 2026 Ishan Nim",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "out/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out/renderer/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "asar": true,
    "electronLanguages": [
      "en-US",
      "ja"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "executableName": "Plume",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdown",
            "mkd",
            "mkdn",
            "mdwn",
            "mdtxt",
            "mdtext"
          ],
          "name": "Plume.Markdown",
          "description": "Markdown Document",
          "role": "Viewer",
          "icon": "resources/md-file.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Plume",
      "deleteAppDataOnUninstall": false,
      "include": "resources/installer.nsh",
      "artifactName": "Plume-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Plume-${version}-mac-${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdown",
            "mkd",
            "mkdn",
            "mdwn",
            "mdtxt",
            "mdtext"
          ],
          "name": "Markdown Document",
          "description": "Markdown Document",
          "role": "Viewer"
        }
      ]
    },
    "dmg": {
      "artifactName": "Plume-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "resources/icon.png",
      "maintainer": "Ishan Nim <ishan.nim@security-pool.io>",
      "synopsis": "A feather-light Markdown viewer",
      "artifactName": "Plume-${version}-linux-${arch}.${ext}",
      "mimeTypes": [
        "text/markdown"
      ]
    }
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
